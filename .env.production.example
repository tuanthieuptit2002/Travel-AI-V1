# Production secrets — copy to .env.production and fill real values.
# Never commit real secrets.

APP_ENV=production
APP_NAME=TripMind AI API
API_V1_PREFIX=/api/v1

POSTGRES_DB=tripmind
POSTGRES_USER=tripmind
POSTGRES_PASSWORD=replace-with-strong-db-password
REDIS_PASSWORD=replace-with-strong-redis-password

DATABASE_URL=postgresql+psycopg://tripmind:replace-with-strong-db-password@postgres:5432/tripmind
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0

SECRET_KEY=replace-with-at-least-32-char-random-secret
AUTH_ENABLED=true
API_KEYS=replace-with-service-api-key
JWT_ISSUER=tripmind-ai
JWT_AUDIENCE=tripmind-api

CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com,localhost

TRAVEL_DATA_MODE=mock
GOOGLE_MAPS_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_BACKOFF_SECONDS=0.5

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

AGENT_MAX_ITERATIONS=16
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOOL_CALLS=80

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PLAN_REQUESTS=10
CACHE_ENABLED=true
LOG_JSON=true
LOG_LEVEL=INFO
SENTRY_DSN=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
API_PORT=8000
WEB_PORT=3000
