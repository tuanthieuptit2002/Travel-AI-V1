APP_ENV=development
APP_NAME=TripMind AI API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://tripmind:change-me-for-local-development@localhost:5432/tripmind
# The pgvector embedding size for TravelKnowledgeDocument. Changing it requires a migration.
EMBEDDING_DIMENSIONS=1536
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=*

# Auth (disabled locally; enable for staging/production)
AUTH_ENABLED=false
SECRET_KEY=dev-only-change-me-tripmind-secret-key-32chars
API_KEYS=
JWT_ISSUER=tripmind-ai
JWT_AUDIENCE=tripmind-api
JWT_EXPIRE_MINUTES=1440
GUEST_TOKEN_EXPIRE_MINUTES=720

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Rate limit + cache
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PLAN_REQUESTS=20
RATE_LIMIT_PLAN_WINDOW_SECONDS=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_WEATHER_TTL_SECONDS=600
CACHE_PLACES_TTL_SECONDS=900

# Travel providers: mock (default) or live
TRAVEL_DATA_MODE=mock
# Server-side only. Never put this in NEXT_PUBLIC_* or the frontend.
GOOGLE_MAPS_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_BACKOFF_SECONDS=0.5

# RAG / embeddings / LLM (server-side only)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
KNOWLEDGE_ROOT=../knowledge
RAG_TOP_K=5

# Agent guards
AGENT_MAX_ITERATIONS=16
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_REPAIR_ATTEMPTS=1
AGENT_MAX_TOOL_CALLS=80

# Observability
LOG_JSON=false
LOG_LEVEL=DEBUG
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
