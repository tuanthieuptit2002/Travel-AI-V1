# Docker infrastructure
POSTGRES_DB=tripmind
POSTGRES_USER=tripmind
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend
APP_ENV=development
APP_NAME=TripMind AI API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://tripmind:change-me-for-local-development@localhost:5432/tripmind
EMBEDDING_DIMENSIONS=1536
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=*
AUTH_ENABLED=false
SECRET_KEY=dev-only-change-me-tripmind-secret-key-32chars
API_KEYS=

# Travel providers (backend only — never expose GOOGLE_MAPS_API_KEY to the frontend)
TRAVEL_DATA_MODE=mock
GOOGLE_MAPS_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_HTTP_MAX_RETRIES=3
PROVIDER_HTTP_BACKOFF_SECONDS=0.5

# RAG / LLM (backend only)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
KNOWLEDGE_ROOT=../knowledge
RAG_TOP_K=5

AGENT_MAX_ITERATIONS=16
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_TOOL_CALLS=80

RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=

# Frontend (public values only — never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
